      "_comment": "GenArk search for yeast: one hub-backed RefSeq assembly. Its hub serves the deterministic chromosome-IV 2bit from the loopback server the Playwright spec starts on port 47831.",
      "method": "GET",
      "host": "api.genome.ucsc.edu",
      "path": "/findGenome",
      "query": {
        "q": "cerevisiae",
        "browser": "mustExist"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
