{
  "name": "@waypoint/desktop",
  "productName": "DNAForge",
  "main": "out/main/index.js",
  "private": true,
  "version": "0.9.3",
  "description": "Desktop app for molecular biology",
  "author": "Humic Labs Inc.",
  "repository": "github:humic-labs/dnaforge-app",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-single-instance-guard.cjs",
    "dev:status": "node scripts/dev-single-instance-guard.cjs --status",
    "dev:restart-stale": "node scripts/dev-single-instance-guard.cjs --restart-stale",
    "dev:stop": "node scripts/dev-single-instance-guard.cjs --stop",
    "dev:hosted-staging": "node scripts/dev-single-instance-guard.cjs --target=hosted-staging",
    "dev:hosted-local": "node scripts/dev-single-instance-guard.cjs --target=hosted-local",
    "dev:raw": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts --mode test",
    "dev:hosted": "vite --config vite.renderer.config.ts --mode hosted --host 127.0.0.1 --port ${DESKTOP_DEV_PORT:-1420} --strictPort",
    "build:hosted": "NODE_ENV=production vite build --config vite.renderer.config.ts --mode hosted",
    "preview:hosted": "vite preview --config vite.renderer.config.ts --mode hosted --host 127.0.0.1 --port ${DESKTOP_DEV_PORT:-1420} --strictPort",
    "agent-tools:generate": "vite-node --config vitest.config.ts scripts/generate-renderer-tool-manifest.ts",
    "agent-tools:check": "vite-node --config vitest.config.ts scripts/generate-renderer-tool-manifest.ts --check",
    "build": "node scripts/check-release-notes.cjs && node scripts/with-build-heap.cjs electron-vite build",
    "prebuild:e2e": "node scripts/prepare-opendataloader-runtime.cjs",
    "build:e2e": "node scripts/dev-single-instance-guard.cjs --assert-stopped && electron-vite build --mode test",
    "check:release-notes": "node scripts/check-release-notes.cjs",
    "check:main-bundle": "node scripts/check-main-bundle.cjs",
    "check:code-editor-chunk": "node scripts/check-code-editor-chunk.cjs",
    "check:packaged-startup": "node scripts/check-packaged-startup.cjs",
    "check:run-from-source": "node scripts/run-from-source-check.mjs",
    "probe:agent-session:live": "node scripts/live-agent-session-smoke.mjs",
    "probe:agent-activity-history:live": "node scripts/live-agent-activity-history-probe.mjs",
    "probe:agent-traces:live": "node scripts/live-agent-trace-probe.mjs",
    "probe:chat-routing:live": "node scripts/live-chat-conversation-routing-probe.mjs",
    "gen:mock-primers": "node scripts/generate-mock-primer-dataset.mjs",
    "catalog:idt:refresh": "node scripts/generate-idt-modification-catalog.mjs --refresh",
    "catalog:idt:check": "node scripts/generate-idt-modification-catalog.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.privileged.json && tsc --noEmit",
    "typecheck:privileged": "tsc --noEmit -p tsconfig.privileged.json",
    "typecheck:privileged-tests": "tsc --noEmit -p tsconfig.privileged-tests.json",
    "preview": "electron-vite preview",
    "electron:preview": "electron-vite preview",
    "prepare:pdf-parser": "node scripts/prepare-opendataloader-runtime.cjs",
    "package": "node scripts/verify-local-package-inputs.cjs && node scripts/prepare-opendataloader-runtime.cjs && node scripts/check-release-notes.cjs && node scripts/rebuild-native.cjs && node scripts/with-build-heap.cjs electron-vite build && node scripts/stage-codex-app-server.cjs && node scripts/run-electron-builder.cjs --mac --config electron-builder.yml",
    "package:dir": "export WAYPOINT_SKIP_NOTARIZE=1 && unset DNAFORGE_RELEASE_BUILD DNAFORGE_RELEASE_CHANNEL DNAFORGE_BUILD_TAG DNAFORGE_QUALIFICATION_EPHEMERAL_AUTH DNAFORGE_TELEMETRY_CANARY_ID DNAFORGE_TELEMETRY_ENVIRONMENT POSTHOG_API_KEY POSTHOG_HOST VITE_POSTHOG_API_KEY VITE_POSTHOG_HOST VITE_SENTRY_DSN SENTRY_DSN VITE_API_URL API_PORT APPLE_ID APPLE_APP_SPECIFIC_PASSWORD APPLE_TEAM_ID DOPPLER_TOKEN DOPPLER_PROJECT DOPPLER_CONFIG ENV && node scripts/verify-local-package-inputs.cjs --acquire && node scripts/prepare-opendataloader-runtime.cjs && node scripts/check-release-notes.cjs && node scripts/rebuild-native.cjs && node scripts/with-build-heap.cjs electron-vite build && node scripts/stage-codex-app-server.cjs && node scripts/run-electron-builder.cjs --mac --dir --config electron-builder.yml && node scripts/verify-package.cjs",
    "package:local": "export WAYPOINT_SKIP_NOTARIZE=1 && unset DNAFORGE_RELEASE_BUILD DNAFORGE_RELEASE_CHANNEL DNAFORGE_BUILD_TAG DNAFORGE_QUALIFICATION_EPHEMERAL_AUTH DNAFORGE_TELEMETRY_CANARY_ID DNAFORGE_TELEMETRY_ENVIRONMENT POSTHOG_API_KEY POSTHOG_HOST VITE_POSTHOG_API_KEY VITE_POSTHOG_HOST VITE_SENTRY_DSN SENTRY_DSN VITE_API_URL API_PORT APPLE_ID APPLE_APP_SPECIFIC_PASSWORD APPLE_TEAM_ID APPLE_API_KEY APPLE_API_KEY_ID APPLE_API_ISSUER APPLE_KEYCHAIN APPLE_KEYCHAIN_PROFILE CSC_LINK CSC_KEY_PASSWORD CSC_NAME DOPPLER_TOKEN DOPPLER_PROJECT DOPPLER_CONFIG ENV && node scripts/verify-local-package-inputs.cjs --acquire && node scripts/prepare-opendataloader-runtime.cjs && node scripts/rebuild-native.cjs && node scripts/with-build-heap.cjs electron-vite build && node scripts/stage-codex-app-server.cjs && node scripts/run-electron-builder.cjs --mac --dir -c.mac.identity=- && node scripts/verify-package.cjs",
    "pretest": "node scripts/install-test-sqlite.cjs",
    "test": "node scripts/run-tests.mjs",
    "test:inline-references": "vitest run src/features/ai/references/inline src/features/ai/assistant-route-capabilities.test.ts src/features/ai/prompts/system-prompt.test.ts src/components/chat/MarkdownMessage.inline-reference.test.tsx src/main/ipc/inline-reference-target.test.ts src/main/conversation-ledger/projection.test.ts",
    "test:registry-longevity": "vitest run src/main/__tests__/lims-registry-longevity.test.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "structure:crawl": "node scripts/structure-corpus-crawl.cjs",
    "structure:crawl:dev-assets": "node scripts/structure-corpus-regression.cjs dev-assets-offline",
    "structure:regression:dev-assets": "node scripts/structure-corpus-regression.cjs dev-assets-live",
    "structure:regression:mg1655": "node scripts/structure-corpus-regression.cjs mg1655-controls",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "postinstall": "node scripts/rebuild-native.cjs && node scripts/stage-codex-app-server.cjs --best-effort",
    "postpackage": "node scripts/verify-package.cjs",
    "helpers:build": "node scripts/build-helpers.cjs"
  },
