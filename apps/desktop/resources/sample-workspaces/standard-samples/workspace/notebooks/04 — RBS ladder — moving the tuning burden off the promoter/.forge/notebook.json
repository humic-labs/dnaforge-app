          },
          {
            "type": "mention",
            "attrs": {
              "id": "sample-7981ffa1",
              "label": "B0034m",
              "entityType": "sequence",
              "entityId": "sample-7981ffa1",
              "path": "sequences/kits/moclo-cidar/B0034m_BC",
              "contentHash": null,
              "objectUuid": null
            }
          },
          {
            "type": "text",
            "text": ". Reporter "
          },
          {
            "type": "mention",
            "attrs": {
              "id": "sample-694681f1",
              "label": "E1010m (mRFP)",
              "entityType": "sequence",
              "entityId": "sample-694681f1",
