    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "RBS ladder \u2014 moving the tuning burden off the promoter"
          }
        ]
      },
      {
        "type": "blockquote",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Directive \u2014 Recover the dynamic range lost by retiring the weak promoter, using translation initiation instead."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Rationale"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Entry 03 showed the promoter ladder is compressed in this backbone. Translation initiation is the other lever, and it is largely orthogonal to transcription \u2014 so tuning here does not perturb the promoter measurements already banked."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Design"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Reference promoter "
          },
          {
            "type": "mention",
            "attrs": {
              "id": "sample-525cf33d",
              "label": "J23106",
              "entityType": "sequence",
              "entityId": "sample-525cf33d",
              "path": "sequences/kits/moclo-cidar/J23106_AB",
              "contentHash": null,
              "objectUuid": null
            }
          },
          {
            "type": "text",
            "text": " fixed. RBS varied across "
          },
          {
            "type": "mention",
            "attrs": {
              "id": "sample-07149c5d",
              "label": "B0032m",
              "entityType": "sequence",
              "entityId": "sample-07149c5d",
