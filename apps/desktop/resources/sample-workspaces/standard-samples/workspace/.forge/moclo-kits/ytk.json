  "recipes": [
    {
      "id": "ytk-multigene-device",
      "name": "YTK hierarchical multigene device",
      "description": "Build a position-specific cassette vector, fill it with an expression cassette, then combine cassette outputs into a multigene device.",
      "stages": [
        {
          "id": "cassette-vector",
          "name": "Build cassette vector",
          "description": "Assemble YTK Type 1, 234r, 5, 6, 7, 8a, and 8b modules into a reusable cassette vector.",
          "enzyme": "BsaI",
          "topology": "circular",
          "outputRole": {
            "id": "ytk:cassette-vector",
            "label": "Cassette vector"
          },
          "slots": [
            {
              "id": "type-1",
              "label": "Type 1 connector",
              "outgoingOverhang": "AACG",
