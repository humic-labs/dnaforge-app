        { "id": "com.dnaforge.pdb", "conformsTo": "public.plain-text", "extensions": ["pdb"] },
        {
          "id": "com.dnaforge.mmcif",
          "conformsTo": "public.plain-text",
          "extensions": ["cif", "mmcif", "mcif"]
        },
        { "id": "com.dnaforge.bcif", "conformsTo": "public.data", "extensions": ["bcif"] }
      ]
    },
    {
      "id": "chromatogram",
      "displayName": "Sanger chromatograms",
      "extensions": ["ab1", "abi"],
      "windows": { "progId": "DNAForge.Chromatogram" },
      "macosTypes": [{ "id": "biosequence.abi", "conformsTo": "public.data" }]
    }
  ]
