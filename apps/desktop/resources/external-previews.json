      "windows": { "progId": "DNAForge.FASTA" },
      "macosTypes": [{ "id": "biosequence.fasta", "conformsTo": "public.plain-text" }]
    },
    {
      "id": "structure",
      "displayName": "Molecular structures",
      "extensions": ["pdb", "cif", "mmcif", "mcif", "bcif"],
      "windows": { "progId": "DNAForge.MolecularStructure" },
