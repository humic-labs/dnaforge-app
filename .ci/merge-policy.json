{
  "version": 1,
  "repository": {
    "id": 1454956566,
    "name": "humic-labs/dnaforge-app",
    "target": "main"
  },
  "authority": {
    "workflow": ".github/workflows/ci.yml",
    "claWorkflow": ".github/workflows/cla.yml",
    "ref": "refs/heads/main",
    "appId": 15368
  },
  "requiredChecks": [
    "Every commit agrees to the CLA",
    "Desktop build, typecheck and tests",
    "Rust helpers and Python sidecar tests",
    "Native workflow acceptance",
    "Merge qualification"
  ],
  "desktop": { "shards": 8 },
  "native": { "journeys": ["workspace", "track", "genome", "canvas", "chat", "palettes"] },
  "delivery": {
    "default": "prepare",
    "holdLabels": ["do-not-merge", "merge-hold", "hold"]
  },
  "queue": {
    "mergeMethod": "MERGE",
    "groupingStrategy": "ALLGREEN",
    "maxEntriesToBuild": 3,
    "minEntriesToMerge": 1,
    "maxEntriesToMerge": 1,
    "checkResponseTimeoutMinutes": 120
  }
}
