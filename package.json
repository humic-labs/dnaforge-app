{
  "name": "dnaforge",
  "private": true,
  "version": "0.0.0",
  "description": "Desktop application for molecular biology: sequence editor, genome browser, cloning and primer design, read alignment, protein structure viewer and lab notebook",
  "scripts": {
    "agent-tools:generate": "pnpm --dir apps/desktop run agent-tools:generate",
    "agent-tools:check": "pnpm --dir apps/desktop run agent-tools:check",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test:registry-longevity": "pnpm --filter @waypoint/desktop test:registry-longevity",
    "test:reference-preparation:integration": "cargo build --release --manifest-path tools/dna-indexer/Cargo.toml && WAYPOINT_REFERENCE_PREPARATION_INTEGRATION=1 pnpm --filter @waypoint/desktop test -- --run src/main/reference-assets/reference-preparation-lifecycle.integration.test.ts",
    "api:generate": "orval && prettier --write \"packages/core/api-client/src/generated/**/*.ts\"",
    "api:generate:watch": "ORVAL_FORMAT_HOOK=1 orval --watch"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
