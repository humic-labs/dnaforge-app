{
  "name": "@waypoint/ui-components",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui/components/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/ui/components/tsconfig.json"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @waypoint/ui-components run test"
      },
      "cache": true
    }
  },
  "tags": ["scope:frontend", "type:ui", "layer:components"]
}
