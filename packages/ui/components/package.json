{
  "name": "@waypoint/ui-components",
  "version": "0.1.0",
  "description": "Shared React UI components for DNAForge",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./keyboard": {
      "types": "./src/keyboard/index.ts",
      "import": "./src/keyboard/index.ts",
      "default": "./src/keyboard/index.ts"
    },
    "./menu": {
      "types": "./src/menu/index.ts",
      "import": "./src/menu/index.ts",
      "default": "./src/menu/index.ts"
    },
    "./menu.css": "./src/menu/menu.css",
    "./styling-check": "./src/menu/styling-check.mjs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "waypoint"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@waypoint/platform": "workspace:*",
    "@waypoint/sequence-utils": "workspace:*",
    "@waypoint/user-messages": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "18.3.18",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18",
    "postcss": "^8.5.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "typescript": ">=5.3.0 <6",
    "postcss": "^8.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "postcss": {
      "optional": true
    }
  }
}
