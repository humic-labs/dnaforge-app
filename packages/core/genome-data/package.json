{
  "name": "@waypoint/genome-data",
  "version": "0.1.0",
  "description": "Indexed genome range-query data layer for sequence, feature, and motif reads",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./test-support": {
      "types": "./src/test-support/indexed-fixtures.ts",
      "import": "./src/test-support/indexed-fixtures.ts",
      "default": "./src/test-support/indexed-fixtures.ts"
    },
    "./annotation-catalog": {
      "types": "./src/annotation-catalog/index.ts",
      "import": "./src/annotation-catalog/index.ts",
      "default": "./src/annotation-catalog/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:stress": "GENOME_DATA_STRESS=1 vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@gmod/indexedfasta": "^5.0.5",
    "@gmod/tabix": "^3.3.3",
    "@waypoint/sequence-utils": "workspace:*",
    "generic-filehandle2": "^2.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
