{
  "name": "@waypoint/compute-endpoints",
  "version": "0.1.0",
  "description": "Provider manifests and contract types for hosted bioinformatics compute endpoints ",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifests/*": "./manifests/*"
  },
  "files": [
    "src",
    "manifests"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
