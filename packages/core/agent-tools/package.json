{
  "name": "@waypoint/agent-tools",
  "version": "0.1.0",
  "description": "defineAction() wrapper + descriptor schema for DNAForge's action surface (Strider). Foundation for WS-B/C/D/E.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest/renderer": "./renderer-tool-manifest.json",
    "./manifest/workflows": "./workflow-manifest.json",
    "./manifest/toolflow-coverage": "./toolflow-coverage-manifest.json",
    "./manifest/native-authoring": "./native-authoring-contract.json",
    "./manifest/capabilities": "./capability-policy.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "dnaforge",
    "agents",
    "actions",
    "strider"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "4.0.18",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
