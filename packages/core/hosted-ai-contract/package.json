{
  "name": "@waypoint/hosted-ai-contract",
  "version": "0.2.0",
  "description": "Versioned structured generation and policy wire contract for DNAForge Hosted AI",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./included-allowance": {
      "types": "./src/included-allowance.ts",
      "dnaforge-node-runtime": "./dist/included-allowance.js",
      "import": "./src/included-allowance.ts",
      "default": "./src/included-allowance.ts"
    },
    "./telemetry-actor": {
      "types": "./src/telemetry-actor.ts",
      "dnaforge-node-runtime": "./dist/telemetry-actor.js",
      "import": "./src/telemetry-actor.ts",
      "default": "./src/telemetry-actor.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "dnaforge-node-runtime": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser-auth": {
      "types": "./src/browser-auth.ts",
      "import": "./src/browser-auth.ts",
      "default": "./src/browser-auth.ts"
    },
    "./wire": {
      "types": "./src/wire.ts",
      "import": "./src/wire.ts",
      "default": "./src/wire.ts"
    },
    "./bounded-json": {
      "types": "./src/bounded-json.ts",
      "dnaforge-node-runtime": "./dist/bounded-json.js",
      "import": "./src/bounded-json.ts",
      "default": "./src/bounded-json.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "zod": "^3.25.76",
    "@waypoint/user-messages": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
