{
  "name": "@waypoint/workspace-revisions",
  "version": "0.2.0",
  "description": "Pure workspace revision graph and merge contracts",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./codec": {
      "types": "./src/codec-public.ts",
      "import": "./src/codec-public.ts",
      "default": "./src/codec-public.ts"
    },
    "./testing": {
      "types": "./src/testing-public.ts",
      "import": "./src/testing-public.ts",
      "default": "./src/testing-public.ts"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:case-fold": "node scripts/generate-unicode-case-fold.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "fast-check": "3.23.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
