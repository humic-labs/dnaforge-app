{
  "name": "@waypoint/workspace-editor",
  "version": "0.1.0",
  "description": "Canvas-based sequence editor with line wrapping for viewing and editing annotated DNA sequences",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./find-bar": {
      "types": "./src/FindBar.tsx",
      "import": "./src/FindBar.tsx",
      "default": "./src/FindBar.tsx"
    },
    "./shift-click-range": {
      "types": "./src/selection-model.ts",
      "import": "./src/selection-model.ts",
      "default": "./src/selection-model.ts"
    },
    "./saved-residue-selection": {
      "types": "./src/saved-residue-selection.ts",
      "import": "./src/saved-residue-selection.ts",
      "default": "./src/saved-residue-selection.ts"
    },
    "./codon-hover-tooltip-lines": {
      "types": "./src/codon-hover-tooltip-lines.ts",
      "import": "./src/codon-hover-tooltip-lines.ts",
      "default": "./src/codon-hover-tooltip-lines.ts"
    },
    "./zoom-math": {
      "types": "./src/zoom-math.ts",
      "import": "./src/zoom-math.ts",
      "default": "./src/zoom-math.ts"
    },
    "./model": {
      "types": "./src/model.ts",
      "import": "./src/model.ts",
      "default": "./src/model.ts"
    },
    "./orf-observation": {
      "import": "./src/orfs/orf-observation.ts",
      "types": "./src/orfs/orf-observation.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "sequence",
    "dna",
    "editor",
    "canvas",
    "bioinformatics"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@waypoint/platform": "workspace:*",
    "@waypoint/sequence-utils": "workspace:*",
    "earcut": "3.2.4",
    "@waypoint/user-messages": "workspace:*"
  },
  "devDependencies": {
    "@types/earcut": "^3.2.4",
    "@types/node": "^20.0.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
