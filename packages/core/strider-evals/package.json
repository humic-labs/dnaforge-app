{
  "name": "@waypoint/strider-evals",
  "version": "0.1.0",
  "description": "Strider eval framework v2 — Vitest mock-LLM runner + safety-coverage safety coverage",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./descriptor": {
      "types": "./src/descriptor/index.ts",
      "import": "./src/descriptor/index.ts",
      "default": "./src/descriptor/index.ts"
    },
    "./runner": {
      "types": "./src/runner/index.ts",
      "import": "./src/runner/index.ts",
      "default": "./src/runner/index.ts"
    },
    "./mock-llm": {
      "types": "./src/mock-llm/index.ts",
      "import": "./src/mock-llm/index.ts",
      "default": "./src/mock-llm/index.ts"
    },
    "./define-action-stub": {
      "types": "./src/define-action-stub/index.ts",
      "import": "./src/define-action-stub/index.ts",
      "default": "./src/define-action-stub/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@waypoint/agent-tools": "workspace:*",
    "vitest": "^4.0.18",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
