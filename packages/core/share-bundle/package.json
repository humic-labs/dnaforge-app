{
  "name": "@waypoint/share-bundle",
  "version": "0.1.0",
  "description": "DNAForge share and backup bundle contract",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "import": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "import": "./src/shared.ts",
      "default": "./src/shared.ts"
    },
    "./sequence-package-admission": {
      "types": "./src/sequence-package-admission.ts",
      "import": "./src/sequence-package-admission.ts",
      "default": "./src/sequence-package-admission.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@waypoint/sequence-utils": "workspace:*",
    "@waypoint/workspace-revisions": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
