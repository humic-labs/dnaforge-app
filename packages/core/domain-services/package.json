{
  "name": "@waypoint/domain-services",
  "version": "0.1.0",
  "description": "Browser-safe product contracts for DNAForge domain services",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./metadata-fields": {
      "types": "./src/metadata-fields.ts",
      "import": "./src/metadata-fields.ts",
      "default": "./src/metadata-fields.ts"
    },
    "./inventory-label-types": {
      "types": "./src/inventory-label-types.ts",
      "import": "./src/inventory-label-types.ts",
      "default": "./src/inventory-label-types.ts"
    },
    "./inventory-labels": {
      "types": "./src/inventory-labels.ts",
      "import": "./src/inventory-labels.ts",
      "default": "./src/inventory-labels.ts"
    },
    "./protocol-package": {
      "types": "./src/protocol-package.ts",
      "import": "./src/protocol-package.ts",
      "default": "./src/protocol-package.ts"
    },
    "./protocol-run-model": {
      "types": "./src/protocol-run-model.ts",
      "import": "./src/protocol-run-model.ts",
      "default": "./src/protocol-run-model.ts"
    },
    "./paper-protocol-model": {
      "types": "./src/paper-protocol-model.ts",
      "import": "./src/paper-protocol-model.ts",
      "default": "./src/paper-protocol-model.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@waypoint/scientific-objects": "workspace:*",
    "@waypoint/workspace-revisions": "workspace:*",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/qrcode": "1.5.6",
    "opentype.js": "2.0.0",
    "typescript": "~5.8.3",
    "vitest": "^4.0.18"
  }
}
